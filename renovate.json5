// Renovate config. Renovate runs self-hosted from guettli/gitops
// (.github/workflows/renovate.yml lists this repo in RENOVATE_REPOSITORIES),
// in a job of its own (no commands allowed). It replaced Dependabot with the
// same cadence: weekly, grouped, 14 days after a release. Coverage: Go modules
// (go.mod, tools/go.mod and tools/actionlint/go.mod, including
// pseudo-version digests), npm
// (package.json), GitHub Actions (pinned by commit SHA) and the Node version of
// setup-node, the Dockerfile base image, and patch releases of the Go toolchain.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  timezone: "Europe/Berlin",
  schedule: ["before 6am on monday"],
  // Dependabot's cooldown.default-days: 14.
  minimumReleaseAge: "14 days",
  prConcurrentLimit: 5,
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      // The toolchain line follows Go patch releases (security fixes) on its
      // own; moving to a new Go minor stays a deliberate change, together with
      // the go line.
      matchManagers: ["gomod"],
      matchDepTypes: ["toolchain"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "kubernetes",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["golang.org/x/**"],
      groupName: "golang.org/x",
    },
    {
      // The tools of CI and the Makefile (go tool -modfile=tools/go.mod).
      matchManagers: ["gomod"],
      matchFileNames: ["tools/go.mod", "tools/actionlint/go.mod"],
      groupName: "tools",
    },
    {
      matchManagers: ["npm"],
      groupName: "npm",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "actions",
    },
  ],
}
